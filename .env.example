# Copy to .env for local use:  cp .env.example .env
# These are development placeholders - use real secrets only in your own
# environment and never commit them.

# --- Docker Compose ---
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
DB_HOST_PORT=5432
API_PORT=8080

# --- Application (used by `make run`, `make seed`, `make migrate-*` on the host) ---
DB_URL=postgres://inventory:inventory@localhost:5432/inventory?sslmode=disable
PORT=8080
ENV=development
